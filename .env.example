# Copy to .env and replace every placeholder before starting the stack.
# Do not commit .env. None of these values are real credentials.

POSTGRES_USER=godesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=godesk
DATABASE_URL=postgres://godesk:change-me@postgres:5432/godesk?sslmode=disable

# At least 32 characters. Also used to seal device passwords unless CREDENTIALS_KEY is set.
JWT_SECRET=change-me-to-a-long-random-string
CREDENTIALS_KEY=

# Public origin the phones can reach. HTTPS is required by SMS Gateway for Android
# except for http://127.0.0.1. Example: https://sms.example.com
PUBLIC_URL=http://godesk.localhost
GODESK_HOST=godesk.localhost

# Optional Authentik (or any OIDC) login. Leave the issuer empty to use email and password only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://godesk.localhost/v1/auth/oidc/callback
